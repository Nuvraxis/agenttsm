{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!**/*.test.ts", "!**/*.test-d.ts"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "passThroughEnv": ["NEXT_TELEMETRY_DISABLED"]
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/conformance/**"],
      "outputs": ["coverage/**"]
    },
    "start": {
      "cache": false,
      "passThroughEnv": [
        "LLM",
        "ANTHROPIC_API_KEY",
        "SERVE",
        "PORT",
        "REQUESTER_TOKEN",
        "REVIEWER_TOKEN",
        "REFUND_API_TOKEN"
      ]
    },
    "//#lint": {
      "inputs": ["$TURBO_DEFAULT$", "!plan.md", "!pnpm-lock.yaml"],
      "outputs": []
    }
  }
}
